name: Native static validation

on:
  pull_request:
    paths:
      - 'native/**'
      - '.github/workflows/native-static.yml'
  push:
    branches:
      - before-release
      - main
      - 'codex/**'
    paths:
      - 'native/**'
      - '.github/workflows/native-static.yml'
  workflow_dispatch:

permissions:
  contents: read

jobs:
  native-static:
    name: Validate native project skeletons and safety gates
    runs-on: ubuntu-latest
    steps:
      - name: Check out repository
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.11'

      - name: Set up Java
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - name: Run Linux-safe native validator
        run: python3 native/validate_native_projects.py

      - name: Check Android Gradle wrapper
        working-directory: native/android
        run: ./gradlew --version --no-daemon

      - name: Build Android debug APK
        working-directory: native/android
        run: ./gradlew assembleDebug --no-daemon

      - name: Check for whitespace errors
        run: git diff --check HEAD

      - name: Report platform build requirements
        run: |
          cat <<'MSG'
          Linux static validation passed.
          Android Gradle wrapper is committed and CI can build the debug APK with:
          - cd native/android && ./gradlew assembleDebug --no-daemon
          Remaining platform validation still requires:
          - iOS: macOS + Xcode + XcodeGen + xcodebuild
          MSG
