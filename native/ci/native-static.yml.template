name: Native static validation

on:
  pull_request:
    paths:
      - 'native/**'
      - '.github/workflows/native-static.yml'
  push:
    branches:
      - before-release
      - main
      - 'codex/**'
    paths:
      - 'native/**'
      - '.github/workflows/native-static.yml'
  workflow_dispatch:

permissions:
  contents: read

jobs:
  native-static:
    name: Validate native project skeletons and safety gates
    runs-on: ubuntu-latest
    steps:
      - name: Check out repository
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.11'

      - name: Set up Java
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - name: Run Linux-safe native validator
        run: python3 native/validate_native_projects.py

      - name: Check Android Gradle wrapper
        working-directory: native/android
        run: ./gradlew --version --no-daemon

      - name: Build Android debug APK
        working-directory: native/android
        run: ./gradlew assembleDebug --no-daemon

      - name: Upload Android APK to Appetize
        if: ${{ secrets.APPETIZE_API_TOKEN != '' }}
        uses: appetizeio/github-action-appetize@v1.0.5
        with:
          apiToken: ${{ secrets.APPETIZE_API_TOKEN }}
          publicKey: ${{ secrets.APPETIZE_PUBLIC_KEY }}
          appFile: native/android/app/build/outputs/apk/debug/app-debug.apk
          platform: android
          fileType: apk
          note: Just Marriage Android debug build from ${{ github.sha }}

      - name: Check for whitespace errors
        run: git diff --check HEAD

      - name: Report platform build requirements
        run: |
          cat <<'MSG'
          Linux static validation passed.
          Android Gradle wrapper is committed and CI can build the debug APK with:
          - cd native/android && ./gradlew assembleDebug --no-daemon
          iOS validation is covered by the macOS template job below when this file is installed as an active workflow.
          MSG

  ios-build:
    name: Generate and build iOS project
    runs-on: macos-14
    steps:
      - name: Check out repository
        uses: actions/checkout@v4

      - name: Install XcodeGen
        run: brew install xcodegen

      - name: Generate Xcode project
        working-directory: native/ios
        run: xcodegen generate

      - name: Build iOS app
        working-directory: native/ios
        run: |
          xcodebuild \
            -project JustMarriage.xcodeproj \
            -scheme JustMarriage \
            -destination 'generic/platform=iOS Simulator' \
            CODE_SIGNING_ALLOWED=NO \
            build
