# Copy this file to deploy_flex_templates.env (ignored) or export the same
# variables in your shell before running deploy_flex_templates.sh.

PROJECT_ID=your-project-id
REGION=your-region
BUCKET_NAME=your-dataflow-assets-bucket
ARTIFACT_REPO=your-artifact-registry-repo
IMAGE_NAME_STREAMING=streaming-pipeline
IMAGE_TAG=release-tag

PINECONE_INDEX=your-pinecone-index
PINECONE_REGION=your-pinecone-region
TOP_K=20

PDF_BUCKET=your-instructions-bucket
PDF_INSTRUCTIONS_PATH=agent-instructions-1.0.pdf

TASKS_LOCATION=your-tasks-location
DELAYED_MATCHING_QUEUE=delayed-matching
NOTIFICATION_QUEUE=match-notifications
VOICE_AGENT_QUEUE=voice-agent-calls
NOTIFICATION_FUNCTION_URL=https://your-notification-service.example.com
VOICE_AGENT_FUNCTION_URL=https://your-voice-agent-service.example.com
DELAYED_TASK_DELAY_SECONDS=300

DATAFLOW_WORKER_SA=dataflow-worker@your-project-id.iam.gserviceaccount.com
IMMEDIATE_TOPIC=user-profile-updated
DELAYED_TOPIC=delayed-matching

# Optional; defaults to template_spec.json.
# STREAMING_METADATA=template_spec.json
