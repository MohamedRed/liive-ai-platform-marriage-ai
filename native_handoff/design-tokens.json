    "white": { "$value": "#FFFFFF" }, "black": { "$value": "#000000" },
    "canvas": { "$value": "#FBFAF8" }, "canvasSunken": { "$value": "#F4F2EE" },
    "green": { "50": { "$value": "#DEF7EC" }, "500": { "$value": "#1FB873" } },
    "amber": { "50": { "$value": "#FFF3D6" }, "500": { "$value": "#FFB020" } },
    "red":   { "50": { "$value": "#FFE3E6" }, "500": { "$value": "#FF4D5E" } }
