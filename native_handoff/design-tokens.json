    "primarySoft":   { "$value": "{color.pink.50}" },
    "onPrimary":     { "$value": "{color.white}" },
    "secondary":     { "$value": "{color.cyan.bright}" },
    "secondaryHover":{ "$value": "{color.cyan.400}" },
    "secondaryPress":{ "$value": "{color.cyan.500}" },
    "secondarySoft": { "$value": "{color.cyan.50}" },
    "onSecondary":   { "$value": "{color.ink.900}" },
    "ink":           { "$value": "{color.ink.900}" },
    "accent":        { "$value": "{color.yellow.400}" },
    "textPrimary":   { "$value": "{color.ink.900}" },
    "textSecondary": { "$value": "{color.ink.600}" },
    "textTertiary":  { "$value": "{color.ink.500}" },
    "textDisabled":  { "$value": "{color.ink.400}" },
