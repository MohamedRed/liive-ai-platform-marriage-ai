    "borderStrong":  { "$value": "{color.ink.900}" },
    "success": { "$value": "{color.green.500}" },
    "warning": { "$value": "{color.amber.500}" },
    "error":   { "$value": "{color.red.500}" },
    "info":    { "$value": "{color.cyan.600}" }
  },
  "spacing": {
    "0": { "$value": "0" }, "1": { "$value": "4" }, "2": { "$value": "8" },
    "3": { "$value": "12" }, "4": { "$value": "16" }, "5": { "$value": "20" },
    "6": { "$value": "24" }, "8": { "$value": "32" }, "10": { "$value": "40" },
    "12": { "$value": "48" }, "16": { "$value": "64" }, "20": { "$value": "80" }, "24": { "$value": "96" }
  },
  "radius": {
    "xs": { "$value": "6" }, "sm": { "$value": "10" }, "md": { "$value": "14" },
