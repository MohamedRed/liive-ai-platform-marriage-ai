  "borderWidth": { "default": { "$value": "1.5" }, "bold": { "$value": "2.5" } },
  "typography": {
    "fontFamily": { "display": { "$value": "Anton" }, "sans": { "$value": "Public Sans" } },
    "weight": { "regular": 400, "medium": 500, "semibold": 600, "bold": 700, "extrabold": 800, "black": 900 },
    "displaySize": { "2xl": 88, "xl": 64, "lg": 48, "md": 36, "sm": 28 },
    "headingSize": { "xl": 32, "lg": 26, "md": 21, "sm": 18, "xs": 16 },
    "bodySize": { "lg": 18, "md": 16, "sm": 14, "xs": 13 },
    "labelSize": { "md": 14, "sm": 12 },
    "lineHeight": { "display": 0.96, "heading": 1.25, "body": 1.55 }
  },
  "motion": {
    "duration": { "fast": 120, "base": 200, "slow": 360 },
    "easing": { "out": "cubic-bezier(0.22,1,0.36,1)", "spring": "cubic-bezier(0.34,1.56,0.64,1)" }
  }
