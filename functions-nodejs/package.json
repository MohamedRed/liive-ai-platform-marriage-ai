{
  "name": "functions",
  "workspaces": [
    "../packages/*"
  ],
  "scripts": {
    "lint": "eslint --config eslint.config.mjs src/",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "predeploy": "cd ../packages/database-types && npm run build && cd ../../functions-nodejs",
    "logs": "firebase functions:log",
    "test": "jest --config=jest.config.js",
    "test:watch": "jest --watch --config=jest.config.js",
    "test:coverage": "jest --coverage --config=jest.config.js"
  },
  "engines": {
    "node": "20"
  },
  "main": "lib/index.js",
  "dependencies": {
    "@google-cloud/pubsub": "^4.11.0",
    "@google-cloud/secret-manager": "^5.6.0",
    "@google-cloud/tasks": "^5.5.2",
    "@googlemaps/google-maps-services-js": "^3.4.0",
    "@livve-1/database-types": "file:./modules/@livve-1/database-types",
    "@pinecone-database/pinecone": "^4.1.0",
    "@stripe/stripe-js": "^4.5.0",
    "@vvo/tzdb": "^6.158.0",
    "axios": "^1.8.3",
    "bottleneck": "^2.19.5",
    "cheerio": "^1.0.0",
    "date-fns-tz": "^3.2.0",
    "eslint-config-prettier": "^9.1.0",
    "firebase-admin": "^13.2.0",
    "firebase-functions": "^6.3.2",
    "firebase-tools": "^13.23.1",
    "livekit-server-sdk": "^2.9.7",
    "openai": "^4.58.0",
    "redis": "^4.6.7",
    "stripe": "^16.12.0",
    "telnyx": "^2.0.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@eslint/compat": "^1.2.2",
    "@eslint/eslintrc": "^3.1.0",
    "@eslint/js": "^9.13.0",
    "@jest/globals": "^29.7.0",
    "@types/jest": "^29.5.12",
    "@types/redis": "^4.0.10",
    "@typescript-eslint/eslint-plugin": "^8.12.1",
    "@typescript-eslint/parser": "^8.12.1",
    "eslint": "^9.13.0",
    "eslint-config-google": "^0.14.0",
    "eslint-plugin-import": "^2.31.0",
    "firebase-functions-test": "^3.1.0",
    "globals": "^15.11.0",
    "jest": "^29.7.0",
    "jest-mock-extended": "^4.0.0-beta1",
    "ts-jest": "^29.1.2",
    "typescript": "^5.6.3"
  },
  "private": true
}
